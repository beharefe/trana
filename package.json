{
  "name": "trana-guard",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm run dev --workspace=apps/web",
    "test": "npm run test --workspaces --if-present",
    "anchor:build": "anchor build -- --features localnet",
    "anchor:build:devnet": "anchor build -- --features devnet",
    "anchor:build:mainnet": "anchor build -- --features mainnet-beta",
    "anchor:test": "anchor test -- --features localnet",
    "anchor:deploy": "anchor deploy",
    "anchor:deploy:local": "anchor deploy",
    "prepare": "[ -n \"$CI\" ] || [ -n \"$VERCEL\" ] || husky"
  },
  "devDependencies": {
    "react":     "^19.0.0",
    "react-dom": "^19.0.0",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@coral-xyz/anchor": "^0.32.0",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.3",
    "@semantic-release/npm": "^12.0.2",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "1.98.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "babel-jest": "^30.3.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "semantic-release": "^24.0.0",
    "ts-jest": "^29.2.5",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "react":     "$react",
    "react-dom": "$react-dom"
  },
  "engines": {
    "node": ">=22"
  }
}
