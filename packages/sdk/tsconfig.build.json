{
  "compilerOptions": {
    "target":           "ES2020",
    "module":           "ESNext",
    "moduleResolution": "bundler",
    "jsx":              "react-jsx",
    "lib":              ["ES2020", "DOM"],
    "outDir":           "dist",
    "rootDir":          "src",
    "declaration":      true,
    "declarationMap":   true,
    "sourceMap":        true,
    "strict":           true,
    "esModuleInterop":  true,
    "skipLibCheck":     true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["src/testing.ts", "src/proof.ts", "node_modules"]
}
