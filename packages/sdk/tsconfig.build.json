{
  "compilerOptions": {
    "target":           "ES2020",
    "module":           "ESNext",
    "moduleResolution": "bundler",
    "lib":              ["ES2020", "DOM"],
    "outDir":           "dist",
    "rootDir":          "src",
    "declaration":      true,
    "declarationMap":   true,
    "sourceMap":        true,
    "strict":           true,
    "esModuleInterop":  true,
    "skipLibCheck":     true,
    "resolveJsonModule": true,
    "baseUrl":          ".",
    "paths": {
      "@noble/curves/nist": ["../../node_modules/@noble/curves/nist.d.ts"]
    }
  },
  "include": [
    "src/index.ts",
    "src/core/**/*",
    "src/guard/**/*",
    "src/authority/**/*",
    "src/testing/**/*",
    "src/types/**/*"
  ]
}
