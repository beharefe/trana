{
  "name": "@tranaprotocol/sdk",
  "version": "1.3.0",
  "description": "Solana passkey guard — TypeScript SDK",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tranaprotocol/trana"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./guard": {
      "types": "./dist/guard/index.d.ts",
      "default": "./dist/guard/index.js"
    },
    "./authority": {
      "types": "./dist/authority/index.d.ts",
      "default": "./dist/authority/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "sync-idl": "node ../../scripts/sync-idl.js",
    "build": "npm run sync-idl && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.0",
    "@noble/curves": "^1.4.0",
    "@solana/web3.js": "1.98.4",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  },
  "peerDependencies": {
    "@solana/web3.js": "1.98.4"
  },
  "keywords": [
    "solana",
    "passkey",
    "webauthn",
    "2fa",
    "anchor",
    "secp256r1"
  ]
}
