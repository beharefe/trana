{
  "name": "@tranaprotocol/guard-sdk",
  "version": "0.1.0",
  "description": "Solana passkey guard — TypeScript SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tranaprotocol/trana"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types":   "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main":  "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev":   "tsc -p tsconfig.build.json --watch",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/web3.js":         "1.98.4",
    "@simplewebauthn/browser": "^13.0.0",
    "buffer":                  "^6.0.3",
    "bs58":                    "^6.0.0"
  },
  "devDependencies": {
    "typescript":       "^5.7.0",
    "@types/node":      "^22.0.0",
    "@types/react":     "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "peerDependencies": {
    "@solana/web3.js":              "1.98.4",
    "@solana/wallet-adapter-react": "^0.15.0",
    "react":                        "^18.0.0 || ^19.0.0",
    "react-dom":                    "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@solana/wallet-adapter-react": { "optional": true },
    "react":     { "optional": true },
    "react-dom": { "optional": true }
  },
  "keywords": ["solana", "passkey", "webauthn", "2fa", "anchor", "secp256r1"]
}
