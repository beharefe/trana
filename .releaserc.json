{
  "branches": ["main"],
  "plugins": [
    ["@semantic-release/commit-analyzer", {
      "preset": "conventionalcommits",
      "releaseRules": [
        { "breaking": true,  "scope": "*sdk*", "release": "major" },
        { "type": "feat",    "scope": "*sdk*", "release": "minor" },
        { "type": "fix",     "scope": "*sdk*", "release": "patch" },
        { "type": "perf",    "scope": "*sdk*", "release": "patch" },
        { "type": "revert",  "scope": "*sdk*", "release": "patch" },
        { "release": false }
      ]
    }],
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", {
      "changelogFile": "packages/sdk/CHANGELOG.md"
    }],
    ["@semantic-release/npm", {
      "pkgRoot": "packages/sdk",
      "npmPublish": true,
      "access": "public"
    }],
    ["@semantic-release/git", {
      "assets": ["packages/sdk/package.json", "packages/sdk/CHANGELOG.md"],
      "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
    }],
    "@semantic-release/github"
  ]
}
