FROM node:22-alpine

WORKDIR /workspace

# Install dependencies (workspace-aware, layer-cached)
COPY package.json package-lock.json ./
COPY packages/sdk/package.json ./packages/sdk/
COPY apps/web/package.json      ./apps/web/
RUN npm ci

# Copy source (hot-reload dirs are overridden by bind mounts at runtime)
COPY packages/sdk ./packages/sdk
COPY apps/web     ./apps/web

EXPOSE 3000

CMD ["sh", "-c", "cd /workspace/apps/web && npx next dev -H 0.0.0.0"]
