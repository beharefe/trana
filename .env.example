# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Bridge Server Ed25519 Key ────────────────────────────────────────────────
# Generate with: node -e "const nacl=require('tweetnacl');const bs58=require('bs58');const kp=nacl.sign.keyPair();console.log(bs58.encode(kp.secretKey))"
SERVER_SECRET_KEY=your-base58-encoded-64-byte-secret-key

# ── Solana ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PROGRAM_ID=your-program-id-after-anchor-deploy
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_GUARD_THRESHOLD_SOL=20

# ── WebAuthn ─────────────────────────────────────────────────────────────────
# Local dev: localhost / deployed: your Vercel domain (no https://, no port)
NEXT_PUBLIC_RP_ID=localhost
RP_ORIGIN=http://localhost:3000
RP_NAME=Trana Guard
